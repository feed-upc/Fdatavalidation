{
  "@context": {
    "@base": "http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dqv": "http://www.w3.org/ns/dqv#",
    "tb": "http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#",
    "ab": "http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#",
    "prov": "http://www.w3.org/ns/prov#"
  },
  "@graph": [
    {
      "@id": "ab:p6",
      "@type": "dqv:QualityPolicy",
      "odrl:permission": [
        {
          "@id": "ab:FreshnessPermission",
          "@type": "odrl:Permission",
          "odrl:assigner": "ab:DataSpaceGovernanceAuthority",
          "odrl:assignee": "ab:DataProvider1",
          "odrl:target": {
            "@id": "ab:Patient_Data"
          },
          "odrl:action": {
            "@id": "odrl:distribute"
          },
          "odrl:constraint": [
            {
              "@id": "ab:FreshnessConstraint",
              "@type": "odrl:Constraint",
              "odrl:operator": "odrl:lteq",
              "odrl:rightOperand": {
                "@value": "30",
                "@type": "xsd:integer"
              },
              "odrl:leftOperand": [
                {
                  "@id": "ab:DataAge",
                  "@type": "dqv:QualityMeasurement"
                }
              ],
              "odrl:unit": {
                "@id": "https://qudt.org/vocab/unit/MIN"
              }
            }
          ]
        }
      ]
    },
    {
      "@id": "ab:DataAge",
      "@type": "dqv:QualityMeasurement",
      "dqv:isMeasurementOf": [
        {
          "@id": "ab:Freshness",
          "@type": "dqv:Metric",
          "dqv:inDimension": [
            {
              "@id": "ab:Timeliness",
              "@type": "dqv:Dimension"
            }
          ]
        }
      ],
      "dqv:computedOn": [
        {
          "@id": "ab:timestamp",
          "@type": "tb:Feature"
        }
      ]
    }
  ]
}
