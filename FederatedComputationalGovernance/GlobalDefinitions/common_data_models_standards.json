{
	"@context": {
		"@vocab": "http://schema.org/",
		"rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
		"rdfs": "http://www.w3.org/2000/01/rdf-schema#",
		"xsd": "http://www.w3.org/2001/XMLSchema#",
		"dcat": "http://www.w3.org/ns/dcat#",
		"dcterms": "http://purl.org/dc/terms/",
		"tb": "http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#",
		"ab": "http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#"
	},
	"@graph": [
		{
			"@id": "ab:EHDS_Patient_Summary",
			"@type": [
				"tb:CommonDataModel",
				"schema:Dataset"
			],
			"name": "EHDS Patient Summary Data Model",
			"description": "Common data model for the European Health Data Space (EHDS) Patient Summary, covering patient identification, hospital affiliation, pregnancy history, allergies, and isolate data for antimicrobial resistance surveillance",
			"creator": {
				"@type": "Organization",
				"name": "FederatedTeam"
			},
			"dcterms:identifier": "EHDS-AMR-PS-001",
			"version": "1.0",
			"dateCreated": "2025-01-01",
			"dateModified": "2026-02-13",
			"variableMeasured": [
				{
					"@id": "schema:identifier",
					"@type": "PropertyValue",
					"name": "National Healthcare Patient ID",
					"description": "National healthcare patient identifier (EHDS-PT-XXXXX)",
					"propertyID": "nationalHealthcarePatientID",
					"valueReference": {
						"@type": "DefinedTerm",
						"name": "Patient Identifier",
						"inDefinedTermSet": "http://purl.obolibrary.org/obo/NCIT_C164337"
					}
				},
				{
					"@id": "ab:familyName",
					"@type": "PropertyValue",
					"name": "Family Name",
					"description": "Patient family name",
					"propertyID": "familyName"
				},
				{
					"@id": "ab:givenName",
					"@type": "PropertyValue",
					"name": "Given Name",
					"description": "Patient given name",
					"propertyID": "givenName"
				},
				{
					"@id": "ab:dateOfBirth",
					"@type": "PropertyValue",
					"name": "Date of Birth",
					"description": "Patient birth date (YYYY-MM-DD)",
					"propertyID": "dateOfBirth"
				},
				{
					"@id": "schema:gender",
					"@type": "PropertyValue",
					"name": "Gender",
					"description": "Patient gender (M/F)",
					"propertyID": "gender",
					"valueReference": {
						"@type": "DefinedTerm",
						"name": "Sex",
						"inDefinedTermSet": "http://purl.obolibrary.org/obo/NCIT_C28421"
					}
				},
				{
					"@id": "ab:countryOfAffiliation",
					"@type": "PropertyValue",
					"name": "Country of Affiliation",
					"description": "Patient country of affiliation (ISO 3166-1 alpha-2)",
					"propertyID": "countryOfAffiliation",
					"valueReference": {
						"@type": "DefinedTerm",
						"name": "Country Code",
						"inDefinedTermSet": "https://www.iso.org/iso-3166-country-codes.html"
					}
				},
				{
					"@id": "ab:hospitalCode",
					"@type": "PropertyValue",
					"name": "Hospital Code",
					"description": "Assigned hospital reference (HOSP-XXXX)",
					"propertyID": "hospitalCode"
				},
				{
					"@id": "ab:hospitalCountry",
					"@type": "PropertyValue",
					"name": "Hospital Country",
					"description": "Hospital country (ISO 3166-1 alpha-2)",
					"propertyID": "hospitalCountry",
					"valueReference": {
						"@type": "DefinedTerm",
						"name": "Country Code",
						"inDefinedTermSet": "https://www.iso.org/iso-3166-country-codes.html"
					}
				},
				{
					"@id": "schema:dateCreated",
					"@type": "PropertyValue",
					"name": "Last Updated",
					"description": "Last update timestamp (ISO 8601)",
					"propertyID": "lastUpdated",
					"valueReference": {
						"@type": "DefinedTerm",
						"name": "Date",
						"inDefinedTermSet": "http://purl.obolibrary.org/obo/NCIT_C25164"
					}
				},
				{
					"@id": "ab:pregnancyHistory",
					"@type": "PropertyValue",
					"name": "Pregnancy History",
					"description": "Pregnancy history linked to patient (derived from PregnancyHistory/CurrencyPregnancyStatus UML entities)",
					"propertyID": "pregnancyHistory"
				},
				{
					"@id": "ab:dateOfObservation",
					"@type": "PropertyValue",
					"name": "Date of Observation",
					"description": "Pregnancy observation date (YYYY-MM-DD)",
					"propertyID": "dateOfObservation"
				},
				{
					"@id": "ab:pregnancyStatus",
					"@type": "PropertyValue",
					"name": "Pregnancy Status",
					"description": "Pregnancy outcome (Delivered, Miscarriage, Ectopic, Stillbirth)",
					"propertyID": "pregnancyStatus"
				},
				{
					"@id": "ab:expectedDateOfDelivery",
					"@type": "PropertyValue",
					"name": "Expected Date of Delivery",
					"description": "Expected delivery date (if applicable)",
					"propertyID": "expectedDateOfDelivery"
				},
				{
					"@id": "ab:allergyDescription",
					"@type": "PropertyValue",
					"name": "Allergy Description",
					"description": "Description of the allergy",
					"propertyID": "allergyDescription"
				},
				{
					"@id": "ab:typeOfPropensity",
					"@type": "PropertyValue",
					"name": "Type of Propensity",
					"description": "Allergy or Intolerance",
					"propertyID": "typeOfPropensity"
				},
				{
					"@id": "ab:allergyManifestation",
					"@type": "PropertyValue",
					"name": "Allergy Manifestation",
					"description": "Clinical manifestation of the allergy",
					"propertyID": "allergyManifestation"
				},
				{
					"@id": "ab:severity",
					"@type": "PropertyValue",
					"name": "Severity",
					"description": "Allergy severity (Mild, Moderate, Severe, Life-threatening)",
					"propertyID": "severity"
				},
				{
					"@id": "ab:criticality",
					"@type": "PropertyValue",
					"name": "Criticality",
					"description": "Allergy criticality (Low, High, Unable to assess)",
					"propertyID": "criticality"
				},
				{
					"@id": "ab:onSetDate",
					"@type": "PropertyValue",
					"name": "Onset Date",
					"description": "Allergy onset date",
					"propertyID": "onSetDate"
				},
				{
					"@id": "ab:endDate",
					"@type": "PropertyValue",
					"name": "End Date",
					"description": "Allergy end date (if resolved)",
					"propertyID": "endDate"
				},
				{
					"@id": "ab:allergyStatus",
					"@type": "PropertyValue",
					"name": "Allergy Status",
					"description": "Allergy status (Active, Resolved, Inactive)",
					"propertyID": "allergyStatus"
				},
				{
					"@id": "ab:certainty",
					"@type": "PropertyValue",
					"name": "Certainty",
					"description": "Allergy certainty (Confirmed, Suspected, Refuted)",
					"propertyID": "certainty"
				},
				{
					"@id": "ab:agentOrAllergen",
					"@type": "PropertyValue",
					"name": "Agent or Allergen",
					"description": "Causative agent of the allergy",
					"propertyID": "agentOrAllergen"
				},
				{
					"@id": "ab:laboratoryCode",
					"@type": "PropertyValue",
					"name": "Laboratory Code",
					"description": "Laboratory identifier for isolate data",
					"propertyID": "laboratoryCode"
				},
				{
					"@id": "ab:specimenDate",
					"@type": "PropertyValue",
					"name": "Specimen Date",
					"description": "Specimen collection date",
					"propertyID": "specimenDate"
				},
				{
					"@id": "ab:specimen",
					"@type": "PropertyValue",
					"name": "Specimen",
					"description": "Specimen type (Blood, Urine, etc.)",
					"propertyID": "specimen"
				},
				{
					"@id": "ab:pathogen",
					"@type": "PropertyValue",
					"name": "Pathogen",
					"description": "Organism identified in isolate",
					"propertyID": "pathogen"
				}
			],
			"measurementTechnique": "European Health Data Space (EHDS) Patient Summary extraction",
			"temporalCoverage": "2024/2026",
			"spatialCoverage": {
				"@type": "Place",
				"name": "European Union (EU-27)"
			},
			"license": "https://creativecommons.org/licenses/by-nc-sa/4.0/",
			"keywords": [
				"EHDS",
				"antimicrobial resistance",
				"patient summary",
				"AMR surveillance",
				"EU health data"
			]
		}
	]
}