abox:ValidationReport-2554decb a tbox:ValidationReport ;
    tbox:executionDuration "0.16847610473632812"^^xsd:float ;
    tbox:executionMode "COMPOSED_UDF" ;
    tbox:resultColumn "Age_at_scan_years",
