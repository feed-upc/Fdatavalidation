        [ tbox:gxKey "attr" ;
            tbox:gxParam "column" ;
            tbox:gxSource "binding" ],
        [ tbox:gxKey "attr" ;
            tbox:gxParam "column" ;
            tbox:gxSource "binding" ] ;
    tbox:gxSetupCode """_cats = sorted(_df['{column}'].dropna().unique().tolist())
    _uniform = {{"values": _cats, "weights": [1.0/len(_cats)]*len(_cats)}}
    _kw['partition_object'] = _uniform""" ;
    tbox:hasCode [ tbox:code "data[attr].value_counts(normalize=True).max() * 100" ],
        [ tbox:code "data[attr].value_counts(normalize=True).max() * 100" ],
        [ tbox:code "data[attr].value_counts(normalize=True).max() * 100" ] ;
