    tbox:gxClass "ExpectColumnKLDivergenceToBeLessThan" ;
    tbox:gxConstraintMode "threshold_scaled" ;
    tbox:gxExpectationType "expect_column_kl_divergence_to_be_less_than" ;
    tbox:gxNeedsDataframe true ;
