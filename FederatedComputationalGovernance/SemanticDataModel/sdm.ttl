abox:0002_Acces a tbox:Acces ;
    rdfs:label abox:Static ;
    tbox:path "/home/acraf/psr/Fdatavalidation/DataProductLayer/DataProduct2/Data/0002.DCM" .

abox:11b8aaa7-9b76-4b92-848d-a2936b5e865b a tbox:SchemaMapping ;
    tbox:mfrom abox:Survival_from_surgery_days_UPDATED ;
    tbox:mto abox:Survival .

abox:1cfb2fbf-2c54-4040-834b-3b508f686537 a tbox:SchemaMapping ;
    tbox:mfrom abox:PatientID ;
    tbox:mto abox:Subject .

abox:1dd41419-7930-4b9e-9f5e-4b1fa65dd72a a tbox:SchemaMapping ;
    tbox:mfrom abox:Gender ;
    tbox:mto abox:Sex .

abox:6dd51e39-6839-4cdc-91fd-3f2edf079f23 a tbox:SchemaMapping ;
    tbox:mfrom abox:target ;
    tbox:mto abox:Survival .

abox:722167d4-1eec-4341-bf59-788b9e9388e5 a tbox:SchemaMapping ;
    tbox:mfrom abox:Age_at_scan_years ;
    tbox:mto abox:Age .

abox:9fd1d6ab-df81-4cde-9957-578672f6953b a tbox:SchemaMapping ;
    tbox:mfrom abox:ID ;
    tbox:mto abox:Subject .

abox:AnonDuty a odrl:Duty ;
    odrl:action odrl:anonymize ;
    odrl:target abox:Subject .

abox:AnonDutyC a odrl:Duty ;
    odrl:constraint odrl:c2 ;
    odrl:target abox:ID .

abox:AnonDutyPrivacy a odrl:Duty ;
    odrl:action odrl:anonymization ;
    odrl:target abox:Age .

abox:CompleteDuty a odrl:Duty ;
    dcterms:description "Duty to ensure age data completeness meets minimum threshold" ;
    dcterms:title "Completeness Requirement" ;
    tbox:physicalAttribute abox:Age_at_scan_years ;
    odrl:constraint <odrl:c1> ;
    odrl:target schema1:age .

abox:DConstraint a odrl:Prohibition ;
    odrl:constraint abox:c4,
        abox:c5 ;
    odrl:target abox:Age .

abox:DataAge a dqv:QualityMeasurement ;
    dcterms:description "Measurement of time elapsed since data creation (computed from timestamp)" ;
    dcterms:title "Data Age Measurement" ;
    dqv:computedOn schema1:dateCreated ;
    dqv:isMeasurementOf abox:Freshness ;
    prov:wasGeneratedBy abox:FreshnessCalculation .

abox:DemographicParity a ns1:FairnessMetric .

abox:FairnessDuty a odrl:Duty ;
    odrl:constraint odrl:c5 ;
    odrl:target abox:Sex .

abox:FairnessTest a ns1:MLModelEvaluation ;
    ns1:hasinput abox:testcsv ;
    ns1:hasoutput abox:DemographicParity .

abox:Freshness a dqv:Metric ;
    dcterms:description "Metric measuring how recent the data is" ;
    dcterms:title "Data Freshness Metric" ;
    schema1:unitText "minutes" ;
    dqv:expectedDataType "xsd:float" ;
    dqv:inDimension dqv:Timeliness .

abox:FreshnessCalculation a prov:Activity ;
    dcterms:description "Calculates time difference between current time and data timestamp" ;
    prov:used "schema:dateCreated" .

abox:FreshnessConstraint a odrl:Constraint ;
    dcterms:description "Data age must be less than or equal to 30 minutes" ;
    dcterms:title "30-Minute Freshness Constraint" ;
    <http://qudt.org/vocab/unit/> <http://qudt.org/vocab/unit/MIN> ;
    odrl:leftOperand abox:DataAge ;
    odrl:operator "odrl:lteq" ;
    odrl:rightOperand 30 .

abox:FreshnessPermission a odrl:Permission ;
    dcterms:description "Permission to distribute data if timestamp freshness constraint is met" ;
    dcterms:title "Freshness-based Distribution Permission" ;
    odrl:action <odrl:distribute> ;
    odrl:constraint abox:FreshnessConstraint ;
    odrl:target abox:Patient_Data .

abox:MembershipInferenceAccuracyRefinement a odrl:Refinement ;
    odrl:leftOperand abox:MembershipInferenceAccuracy ;
    odrl:operator odrl:lt ;
    odrl:rightOperand 5e+01 .

