            tbox:name "attr" ;
            tbox:role "attributeReference" ;
            tbox:type "string" ],
        [ tbox:description "Data to assess" ;
            tbox:name "data" ;
            tbox:role "previousResult" ;
            tbox:type "DataFrame" ],
        [ tbox:description "Column to check for fairness (e.g., gender)" ;
            tbox:name "attr" ;
            tbox:role "attributeReference" ;
            tbox:type "string" ],
        [ tbox:description "Data to assess" ;
            tbox:name "data" ;
            tbox:role "previousResult" ;
            tbox:type "DataFrame" ],
        [ tbox:description "Column to check for fairness (e.g., gender)" ;
            tbox:name "attr" ;
            tbox:role "attributeReference" ;
            tbox:type "string" ],
        [ tbox:description "Data to assess" ;
            tbox:name "data" ;
            tbox:role "previousResult" ;
            tbox:type "DataFrame" ] ;
    ns1:comment "DQRP6 (DQR5EH): Fairness check - calculates max percentage of any discrete group",
        "DQRP6 (DQR5EH): Fairness check - class imbalance via KL divergence" .

