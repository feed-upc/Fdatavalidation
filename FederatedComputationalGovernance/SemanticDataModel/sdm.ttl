    rdfs:label abox:Static ;
    tbox:path "/home/acraf/psr/Fdatavalidation/DataProductLayer/DataProduct2/Data/0002.DCM" .

abox:092ddfb3-afaf-4d21-92f2-c74ff463d23f a tbox:SchemaMapping ;
    tbox:mfrom abox:Age_at_scan_years ;
    tbox:mto abox:Age .

abox:33f7fed9-aba7-4ae8-a975-7fe70f6db32b a tbox:SchemaMapping ;
    tbox:mfrom abox:ID ;
    tbox:mto abox:Subject .

abox:94ba928a-84e4-4d03-aad8-ef5ba282ab61 a tbox:SchemaMapping ;
    tbox:mfrom abox:target ;
    tbox:mto abox:Survival .

abox:DQRP1_Constraint a odrl:Constraint ;
    rdfs:comment "Data age must not exceed 30 minutes" ;
    odrl:leftOperand abox:DataAge ;
    odrl:operator odrl:lteq ;
    odrl:rightOperand 30 ;
    odrl:unit <http://qudt.org/vocab/unit/MIN> .

abox:DQRP1_Permission a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:assignee abox:DataProvider ;
    odrl:assigner abox:DataSpaceGovernanceAuthority ;
    odrl:constraint abox:DQRP1_Constraint ;
    odrl:target abox:Patient_Data .

abox:DQRP2_Constraint a odrl:Constraint ;
    rdfs:comment "Completeness must be at least 99%" ;
    odrl:leftOperand abox:qM ;
    odrl:operator odrl:gteq ;
    odrl:rightOperand 99.0 .

abox:DQRP2_Duty a odrl:Duty ;
    rdfs:comment "Age_at_scan_years attribute must contain at least 99% non-empty values" ;
    odrl:constraint abox:DQRP2_Constraint ;
    odrl:target abox:Age .

abox:DQRP3_Constraint a odrl:Constraint ;
    rdfs:comment "Values must be part of controlled vocabulary" ;
    odrl:leftOperand abox:CheckValidity ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand abox:GenderVocabulary .

abox:DQRP3_Duty a odrl:Duty ;
    rdfs:comment "Gender attribute values must be in the controlled vocabulary {M, F}" ;
    odrl:constraint abox:DQRP3_Constraint ;
    odrl:target abox:Sex .

abox:DQRP4_Constraint a odrl:Constraint ;
    rdfs:comment "Cross-attribute consistency: Deceased patients must have survival days > 0" ;
    odrl:leftOperand abox:CheckConsistency ;
    odrl:operator odrl:eq ;
    odrl:rightOperand true .

abox:DQRP4_Duty a odrl:Duty ;
    rdfs:comment "Survival_from_surgery_days must be greater than 0 when patient is Deceased" ;
    odrl:constraint abox:DQRP4_Constraint ;
    odrl:target abox:Survival .

abox:DataAge a dqv:QualityMeasurement ;
    rdfs:label "Data Age Measurement" ;
    rdfs:comment "Measures the time elapsed since data was recorded/updated" ;
    dqv:computedOn abox:timestamp ;
    dqv:isMeasurementOf abox:Freshness .

abox:Freshness a dqv:Metric ;
    rdfs:label "Freshness Metric" ;
    dqv:inDimension abox:Timeliness .

