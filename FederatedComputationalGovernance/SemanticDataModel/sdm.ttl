tbox:Library a owl:Class ;
    rdfs:label "Library"@en ;
    rdfs:comment "Software library that provides implementations (e.g., pandas, numpy)"@en ;
    rdfs:subClassOf prov:SoftwareAgent .

dqv:Dimension a owl:Class .

dqv:QualityMeasurement a owl:Class .

dqv:QualityPolicy a owl:Class ;
    rdfs:subClassOf odrl:Policy .

odrl:Permission a owl:Class .

dcat:Dataset a owl:Class .

schema1:PropertyValue a owl:Class .

odrl:Policy a owl:Class .

dqv:Metric a owl:Class .

tbox:DataProduct a owl:Class ;
    rdfs:label "Data Product"@en ;
    rdfs:comment "A data product with governance policies. Subclass of both DCAT Dataset and ODRL Asset"@en ;
    rdfs:subClassOf dcat:Dataset,
        odrl:Asset .

odrl:Asset a owl:Class .

csvw:Column a owl:Class .

tbox:Attribute a owl:Class ;
    rdfs:label "Attribute"@en ;
    rdfs:comment "DEPRECATED: Use csvw:Column instead. Physical column or attribute in a dataset"@en ;
    owl:deprecated true ;
    owl:equivalentClass csvw:Column .

tbox:PolicyChecker a owl:Class ;
    rdfs:label "Policy Checker"@en ;
    rdfs:comment "Executable representation of a policy that validates data products. Contains operation chain and parameter bindings."@en ;
    rdfs:subClassOf prov:Activity .

tbox:Implementation a owl:Class ;
    rdfs:label "Implementation"@en ;
    rdfs:comment "Executable implementation of an operation with code template and library reference"@en ;
    rdfs:subClassOf prov:Plan .

tbox:ValidationReport a owl:Class ;
    rdfs:label "Validation Report"@en ;
    rdfs:comment "Report generated from PolicyChecker execution containing status, timing, and result metadata"@en ;
    rdfs:subClassOf prov:Entity .

tbox:Operation a owl:Class ;
    rdfs:label "Operation"@en ;
    rdfs:comment "Individual operation in a validation chain (e.g., LoadData, CheckFreshness, QualityMetric)"@en ;
    rdfs:subClassOf prov:Activity .

