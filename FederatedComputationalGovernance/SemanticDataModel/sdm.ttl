@prefix abox: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix tbox: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:identifier a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf ( odrl:Asset tbox:DataProduct dcat:Dataset ) ],
        [ owl:unionOf ( odrl:Asset tbox:DataProduct dcat:Dataset ) ] ;
    rdfs:range xsd:string .

abox:DQRP3 a dqv:QualityPolicy ;
    rdfs:label "DQRP3 - Validity Requirement (DQR2EH)" ;
    tbox:derivedFrom "DQRP3" ;
    tbox:ehdsRequirement "DQR2EH" ;
    tbox:qualityDimension "Validity" ;
    tbox:sourceEntity abox:DataSpaceGovernanceAuthority ;
    rdfs:comment "Data Quality Requirement Pattern 3: Patient affiliation countries must be referenced using country codes from the ISO 3166 International Standard (EHDS DQR2EH - ISO/IEC 25012 Validity)" ;
    odrl:duty abox:DQRP3_Duty .

abox:DQRP4 a dqv:QualityPolicy ;
    rdfs:label "DQRP4 - Consistency Requirement (DQR3EH)" ;
    tbox:consistencyRule abox:DQRP4_Rule ;
    tbox:derivedFrom "DQRP4" ;
    tbox:ehdsRequirement "DQR3EH" ;
    tbox:qualityDimension "Consistency" ;
    tbox:sourceEntity abox:DataSpaceGovernanceAuthority ;
    rdfs:comment "Data Quality Requirement Pattern 4: Male patients shall not have any recorded pregnancy history (EHDS DQR3EH - ISO/IEC 25012 Consistency)" ;
    odrl:duty abox:DQRP4_Duty .

abox:DQRP5 a dqv:QualityPolicy ;
    rdfs:label "DQRP5 - Sample Size Requirement (DQR4EH)" ;
    tbox:derivedFrom "DQRP5" ;
    tbox:ehdsRequirement "DQR4EH" ;
    tbox:qualityDimension "Validity" ;
    tbox:sourceEntity abox:DataSpaceGovernanceAuthority ;
    rdfs:comment "Data Quality Requirement Pattern 5: To obtain reliable estimates of antimicrobial resistance rates, a minimum total sample size of at least 2,000 isolates is required (EHDS DQR4EH - DAMA-DMBOK Validity)" ;
    odrl:duty abox:DQRP5_Duty .

abox:DQRP6 a dqv:QualityPolicy ;
    rdfs:label "DQRP6 - Fairness Requirement (DQR5EH)" ;
    tbox:derivedFrom "DQRP6" ;
    tbox:ehdsRequirement "DQR5EH" ;
    tbox:fairnessConfig abox:DQRP6_FairnessConfig ;
    tbox:qualityDimension "Fairness" ;
    tbox:sourceEntity abox:DataSpaceGovernanceAuthority ;
    rdfs:comment "Data Quality Requirement Pattern 6: Accurate estimation of antimicrobial resistance rates requires a study population with balanced representation of male and female patients, ideally a 1:1 ratio, to mitigate potential biases arising from the under-representation of women commonly reported in clinical research (EHDS DQR5EH - Biessmann et al. 2021 Fairness)" ;
    odrl:duty abox:DQRP6_Duty .

abox:DQRP7 a dqv:QualityPolicy ;
    rdfs:label "DQRP7 - Hospital Country Validity (DQR6EH)" ;
    tbox:derivedFrom "DQRP3" ;
    tbox:ehdsRequirement "DQR6EH" ;
    tbox:qualityDimension "Validity" ;
    tbox:sourceEntity abox:DataSpaceGovernanceAuthority ;
    rdfs:comment "Data Quality Requirement Pattern 7: Hospital countries must be referenced using country codes from the ISO 3166 International Standard (EHDS DQR6EH - ISO/IEC 25012 Validity)" ;
    odrl:duty abox:DQRP7_Duty .

<http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox> a owl:Ontology ;
    rdfs:label "HealthMesh Ontology"@en ;
    dcterms:created "2024-01-01"^^xsd:date ;
    dcterms:creator "Achraf Hmimou (UPC)"@en,
        "Aniol Bisquert (UPC)"@en ;
    dcterms:description "Ontology for federated data governance with policy-driven validation, aligned with W3C standards"@en ;
    dcterms:modified "2025-12-16"^^xsd:date ;
    dcterms:title "HealthMesh Data Governance Ontology"@en ;
    owl:imports csvw:,
        dcat:,
        dqv:,
        odrl:,
        prov: ;
    owl:versionIRI <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/1.0> ;
    owl:versionInfo "1.0 - Standards-aligned version using DCAT, CSVW, DQV, PROV-O, Schema.org" .

tbox:DCPolicy a owl:Class ;
    rdfs:label "Data Consent Policy"@en ;
    rdfs:comment "Policy governing data consent and usage restrictions"@en ;
    rdfs:subClassOf odrl:Policy .

tbox:FairnessPolicy a owl:Class ;
    rdfs:label "Fairness Policy"@en ;
    rdfs:comment "Policy ensuring fairness constraints on ML models"@en ;
    rdfs:subClassOf odrl:Policy .

tbox:accordingTo a owl:ObjectProperty ;
    rdfs:label "according to"@en ;
    rdfs:comment "Links a PolicyChecker to the Policy it validates"@en ;
    rdfs:domain tbox:PolicyChecker ;
    rdfs:range odrl:Policy .

tbox:attribute a owl:DatatypeProperty ;
    rdfs:label "attribute name"@en ;
    rdfs:comment "Physical column or attribute name. Aligns with csvw:name"@en ;
    rdfs:domain tbox:Attribute ;
    rdfs:range xsd:string ;
    owl:equivalentProperty csvw:name .

tbox:code a owl:DatatypeProperty ;
    rdfs:label "code"@en ;
    rdfs:comment "Source code or template string"@en ;
    rdfs:domain tbox:Code ;
    rdfs:range xsd:string .

tbox:executionDuration a owl:DatatypeProperty ;
    rdfs:label "execution duration"@en ;
    rdfs:comment "Execution duration in seconds"@en ;
    rdfs:domain tbox:ValidationReport ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf prov:value .

tbox:executionMode a owl:DatatypeProperty ;
    rdfs:label "execution mode"@en ;
    rdfs:comment "Mode of execution (e.g., COMPOSED_UDF, SEQUENTIAL)"@en ;
    rdfs:domain tbox:ValidationReport ;
    rdfs:range xsd:string .

tbox:feature a owl:DatatypeProperty ;
    rdfs:label "feature name"@en ;
    rdfs:comment "DEPRECATED: Use schema:name instead. Semantic feature name"@en ;
    rdfs:domain tbox:Feature ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    owl:equivalentProperty schema1:name .

tbox:hasAttribute a owl:ObjectProperty ;
    rdfs:label "has attribute"@en ;
    rdfs:comment "DEPRECATED: Use csvw:column instead. Links a Dataset to its Attributes"@en ;
    rdfs:domain dcat:Dataset ;
    rdfs:range tbox:Attribute ;
    owl:deprecated true ;
    owl:equivalentProperty csvw:column .

tbox:hasDC a owl:ObjectProperty ;
    rdfs:label "has data contract"@en ;
    rdfs:comment "Links a DataProduct to its DataContract (governance agreement)"@en ;
    rdfs:domain tbox:DataProduct ;
    rdfs:range tbox:DataContract ;
    rdfs:subPropertyOf dcterms:conformsTo .

tbox:hasDTT a owl:ObjectProperty ;
    rdfs:label "has dataset type template"@en ;
    rdfs:comment "Links a DataProduct to its DatasetTypeTemplate (format specification)"@en ;
    rdfs:domain tbox:DataProduct ;
    rdfs:range tbox:DatasetTypeTemplate ;
    rdfs:subPropertyOf dcterms:format .

tbox:hasFeature a owl:ObjectProperty ;
    rdfs:label "has feature"@en ;
    rdfs:comment "Links a CommonDataModel to semantic features. Consider using schema:variableMeasured"@en ;
    rdfs:domain tbox:CommonDataModel ;
    rdfs:range tbox:Feature ;
    owl:equivalentProperty schema1:variableMeasured .

tbox:hasImplementation a owl:ObjectProperty ;
    rdfs:label "has implementation"@en ;
    rdfs:comment "Links an Operation to its executable Implementation"@en ;
    rdfs:domain tbox:Operation ;
    rdfs:range tbox:Implementation .

tbox:hasLibrary a owl:ObjectProperty ;
    rdfs:label "has library"@en ;
    rdfs:comment "Links an Implementation to the Library that provides it"@en ;
    rdfs:domain tbox:Implementation ;
    rdfs:range tbox:Library .

tbox:hasMethod a owl:ObjectProperty ;
    rdfs:label "has method"@en ;
    rdfs:comment "Links an Implementation to the Code that implements it"@en ;
    rdfs:domain tbox:Implementation ;
    rdfs:range tbox:Code .

tbox:hasPolicy a owl:ObjectProperty ;
    rdfs:label "has policy"@en ;
    rdfs:comment "Links a DataContract to the Policies it enforces"@en ;
    rdfs:domain tbox:DataContract ;
    rdfs:range odrl:Policy .

tbox:hasTA a owl:ObjectProperty ;
    rdfs:label "has technology aspects"@en ;
    rdfs:comment "Links a DataProduct to its TechnologyAspects (access and storage details)"@en ;
    rdfs:domain tbox:DataProduct ;
    rdfs:range tbox:TechnologyAspects ;
    rdfs:subPropertyOf dcat:distribution .

tbox:hasTemplate a owl:ObjectProperty ;
    rdfs:label "has template"@en ;
    rdfs:comment "Links a PolicyChecker to its execution template"@en ;
    rdfs:domain tbox:PolicyChecker .

tbox:hasValidationReport a owl:ObjectProperty ;
    rdfs:label "has validation report"@en ;
    rdfs:comment "Links a PolicyChecker to its ValidationReport (generated after execution)"@en ;
    rdfs:domain tbox:PolicyChecker ;
    rdfs:range tbox:ValidationReport .

tbox:implements a owl:ObjectProperty ;
    rdfs:label "implements"@en ;
    rdfs:comment "References implementation details of a PolicyChecker"@en ;
    rdfs:domain tbox:PolicyChecker .

tbox:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Name of a Library or resource"@en ;
    rdfs:domain [ owl:unionOf ( tbox:Library tbox:Implementation ) ],
        [ owl:unionOf ( tbox:Library tbox:Implementation ) ] ;
    rdfs:range xsd:string ;
    owl:equivalentProperty schema1:name .

tbox:nextStep a owl:ObjectProperty ;
    rdfs:label "next step"@en ;
    rdfs:comment "Links to the next Operation in a validation chain"@en ;
    rdfs:domain [ owl:unionOf ( tbox:Operation tbox:PolicyChecker ) ],
        [ owl:unionOf ( tbox:Operation tbox:PolicyChecker ) ] ;
    rdfs:range tbox:Operation .

tbox:operation a owl:DatatypeProperty ;
    rdfs:label "operation"@en ;
    rdfs:comment "Operation identifier or name"@en ;
    rdfs:domain tbox:Operation ;
    rdfs:range xsd:string ;
    owl:equivalentProperty schema1:name .

tbox:owner a owl:DatatypeProperty ;
    rdfs:label "owner"@en ;
    rdfs:comment "DEPRECATED: Use dcterms:creator or dcterms:publisher instead"@en ;
    rdfs:domain [ owl:unionOf ( odrl:Asset tbox:DataProduct ) ],
        [ owl:unionOf ( odrl:Asset tbox:DataProduct ) ] ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    owl:equivalentProperty dcterms:creator .

tbox:resultColumn a owl:DatatypeProperty ;
    rdfs:label "result column"@en ;
    rdfs:comment "Column name in validation result"@en ;
    rdfs:domain tbox:ValidationReport ;
    rdfs:range xsd:string .

tbox:resultColumnCount a owl:DatatypeProperty ;
    rdfs:label "result column count"@en ;
    rdfs:comment "Number of columns in validation result (for DataFrame)"@en ;
    rdfs:domain tbox:ValidationReport ;
    rdfs:range xsd:integer .

tbox:resultRowCount a owl:DatatypeProperty ;
    rdfs:label "result row count"@en ;
    rdfs:comment "Number of rows in validation result (for DataFrame)"@en ;
    rdfs:domain tbox:ValidationReport ;
    rdfs:range xsd:integer .

tbox:resultType a owl:DatatypeProperty ;
    rdfs:label "result type"@en ;
    rdfs:comment "Data type of the validation result"@en ;
    rdfs:domain tbox:ValidationReport ;
    rdfs:range xsd:string .

tbox:resultValue a owl:DatatypeProperty ;
    rdfs:label "result value"@en ;
    rdfs:comment "Scalar result value from validation"@en ;
    rdfs:domain tbox:ValidationReport .

tbox:supports a owl:ObjectProperty ;
    rdfs:label "supports"@en ;
    rdfs:comment "Links a Library to the DatasetTypeTemplates it supports"@en ;
    rdfs:domain tbox:Library ;
    rdfs:range tbox:DatasetTypeTemplate .

tbox:template a owl:DatatypeProperty ;
    rdfs:label "template"@en ;
    rdfs:comment "Template string for code generation"@en ;
    rdfs:range xsd:string .

tbox:validates a owl:ObjectProperty ;
    rdfs:label "validates"@en ;
    rdfs:comment "Links a PolicyChecker to the DataProduct it validates"@en ;
    rdfs:domain tbox:PolicyChecker ;
    rdfs:range tbox:DataProduct .

tbox:validationStatus a owl:DatatypeProperty ;
    rdfs:label "validation status"@en ;
    rdfs:comment "Status of validation execution: PASSED, FAILED, or COMPLETED"@en ;
    rdfs:domain tbox:ValidationReport ;
    rdfs:range xsd:string .

csvw:Table a owl:Class .

csvw:TableSchema a owl:Class .

dcat:DataService a owl:Class .

odrl:Privacy a owl:Class ;
    rdfs:subClassOf odrl:Policy .

odrl:Prohibition a owl:Class .

dcterms:format a owl:DatatypeProperty ;
    rdfs:domain tbox:DatasetTypeTemplate ;
    rdfs:range xsd:string .

schema1:Dataset a owl:Class .

abox:1b7f0c05-40c9-4de7-b8f5-40b373a8260c a tbox:SchemaMapping ;
    tbox:mfrom abox:countryOfAffiliation ;
    tbox:mto abox:AffiliationCountry .

abox:28246e20-3a43-4431-a7ce-d4bad78a7bd2 a tbox:SchemaMapping ;
    tbox:mfrom abox:gender ;
    tbox:mto abox:Sex .

abox:3e48d717-bdb2-4c24-a179-30439be165cd a tbox:SchemaMapping ;
    tbox:mfrom abox:hospitalCountry ;
    tbox:mto abox:HospitalCountry .

abox:4f72c429-9e7c-4f3a-bdd2-72cac232d8a1 a tbox:SchemaMapping ;
    tbox:mfrom abox:lastUpdated ;
    tbox:mto abox:timestamp .

abox:54ec2913-90dd-4d57-a1e7-33e72f79f209 a tbox:SchemaMapping ;
    tbox:mfrom abox:nationalHealthcarePatientID ;
    tbox:mto abox:Subject .

abox:AMR_Specimen a tbox:Entity ;
    rdfs:label "AMR Specimen Entity" ;
    rdfs:comment "Antimicrobial resistance specimen data for EHDS cross-border surveillance" .

abox:CheckConsistency a dqv:Metric,
        dqv:QualityMeasurement ;
    rdfs:label "Cross-Attribute Consistency Check Metric" ;
    dqv:inDimension abox:Consistency .

abox:Consistency a dqv:Dimension .

abox:DQRP1_Constraint a odrl:Constraint ;
    rdfs:comment "Data age must not exceed 30 minutes" ;
    odrl:leftOperand abox:DataAge ;
    odrl:operator odrl:lteq ;
    odrl:rightOperand 30 ;
    odrl:unit qudt:MIN .

abox:DQRP1_Permission a odrl:Permission ;
    rdfs:comment "Data may only be distributed if its age does not exceed 30 minutes" ;
    odrl:action "odrl:distribute" ;
    odrl:assignee abox:DataProvider ;
    odrl:assigner abox:DataSpaceGovernanceAuthority ;
    odrl:constraint abox:DQRP1_Constraint ;
    odrl:target abox:EHDS_Patient_Summary .

abox:DQRP3_Constraint a odrl:Constraint ;
    rdfs:comment "Values must be part of ISO 3166 country code vocabulary" ;
    odrl:leftOperand abox:CheckValidity ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand abox:ISO3166CountryCodeVocabulary .

abox:DQRP3_Duty a odrl:Duty ;
    rdfs:comment "AffiliationCountry attribute values must be valid ISO 3166-1 alpha-2 country codes" ;
    odrl:constraint abox:DQRP3_Constraint ;
    odrl:target abox:AffiliationCountry .

abox:DQRP4_Constraint a odrl:Constraint ;
    rdfs:comment "Cross-attribute consistency: Male patients must have no pregnancy records" ;
    odrl:leftOperand abox:CheckConsistency ;
    odrl:operator odrl:eq ;
    odrl:rightOperand true .

abox:DQRP4_Duty a odrl:Duty ;
    rdfs:comment "Male patients must have pregnancy history count equal to 0 (cross-attribute consistency)" ;
    odrl:constraint abox:DQRP4_Constraint ;
    odrl:target abox:PregnancyHistory .

abox:DQRP4_Rule a tbox:CrossAttributeRule ;
    tbox:conditionAttribute abox:Sex ;
    tbox:conditionValue "M" ;
    tbox:targetAttribute abox:PregnancyHistory ;
    tbox:targetOperator "odrl:eq" ;
    tbox:targetValue 0 ;
    rdfs:comment "IF Sex = 'M' THEN PregnancyHistory = 0" .

abox:DQRP5_Constraint a odrl:Constraint ;
    rdfs:comment "Minimum total isolate count must be at least 2000" ;
    odrl:leftOperand abox:TotalIsolateCount ;
    odrl:operator odrl:gteq ;
    odrl:rightOperand 2000 .

abox:DQRP5_Duty a odrl:Duty ;
    rdfs:comment "AMR specimen dataset must have at least 2000 isolates for statistically valid resistance rate estimates" ;
    odrl:constraint abox:DQRP5_Constraint ;
    odrl:target abox:AMR_Specimen .

abox:DQRP6_Constraint_Female a odrl:Constraint ;
    rdfs:comment "Female representation must be approximately 50%" ;
    odrl:leftOperand abox:GroupRepresentation_Female ;
    odrl:operator odrl:eq ;
    odrl:rightOperand 50.0 ;
    odrl:unit abox:Percentage .

abox:DQRP6_Constraint_Male a odrl:Constraint ;
    rdfs:comment "Male representation must be approximately 50%" ;
    odrl:leftOperand abox:GroupRepresentation_Male ;
    odrl:operator odrl:eq ;
    odrl:rightOperand 50.0 ;
    odrl:unit abox:Percentage .

abox:DQRP6_Duty a odrl:Duty ;
    rdfs:comment "Gender distribution in AMR study population must be balanced (50% male, 50% female) to prevent bias in resistance rate estimates" ;
    odrl:constraint abox:DQRP6_Constraint_Female,
        abox:DQRP6_Constraint_Male ;
    odrl:target abox:Patient_Summary .

abox:DQRP6_FairnessConfig a tbox:FairnessConfiguration ;
    tbox:groupDistribution abox:FemaleGroup,
        abox:MaleGroup ;
    tbox:protectedAttribute abox:Sex .

abox:DQRP7_Constraint a odrl:Constraint ;
    rdfs:comment "Values must be part of ISO 3166 country code vocabulary" ;
    odrl:leftOperand abox:CheckValidity ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand abox:ISO3166CountryCodeVocabulary .

abox:DQRP7_Duty a odrl:Duty ;
    rdfs:comment "HospitalCountry attribute values must be valid ISO 3166-1 alpha-2 country codes" ;
    odrl:constraint abox:DQRP7_Constraint ;
    odrl:target abox:HospitalCountry .

abox:DataAge a dqv:Metric,
        dqv:QualityMeasurement ;
    rdfs:label "Data Age Measurement" ;
    rdfs:comment "Measures the time elapsed since data was recorded/updated via the lastUpdated attribute" ;
    dqv:computedOn abox:timestamp ;
    dqv:isMeasurementOf abox:Freshness .

abox:EHDS_Patient_Summary a tbox:CommonDataModel,
        <schema:Dataset> ;
    dcterms:identifier "EHDS-AMR-PS-001" ;
    schema1:creator [ a schema1:Organization ;
            schema1:name "FederatedTeam" ],
        [ a schema1:Organization ;
            schema1:name "FederatedTeam" ] ;
    schema1:dateCreated "2025-01-01" ;
    schema1:dateModified "2026-02-13" ;
    schema1:description "Common data model for the European Health Data Space (EHDS) Patient Summary, covering patient identification, hospital affiliation, and temporal metadata for antimicrobial resistance surveillance" ;
    schema1:keywords "AMR surveillance",
        "EHDS",
        "EU health data",
        "antimicrobial resistance",
        "patient summary" ;
    schema1:license "https://creativecommons.org/licenses/by-nc-sa/4.0/" ;
    schema1:measurementTechnique "European Health Data Space (EHDS) Patient Summary extraction" ;
    schema1:name "EHDS Patient Summary Data Model" ;
    schema1:spatialCoverage [ a schema1:Place ;
            schema1:name "European Union (EU-27)" ],
        [ a schema1:Place ;
            schema1:name "European Union (EU-27)" ] ;
    schema1:temporalCoverage "2024/2026" ;
    schema1:variableMeasured abox:AffiliationCountry,
        abox:HospitalCountry,
        <schema:dateCreated>,
        <schema:gender>,
        <schema:identifier> ;
    schema1:version "1.0" .

abox:FemaleGroup tbox:groupValue "F" ;
    tbox:targetPercentage 50.0 .

abox:Freshness a dqv:Metric ;
    rdfs:label "Freshness Metric" ;
    dqv:inDimension abox:Timeliness .

abox:GroupRepresentation_Female a dqv:Metric,
        dqv:QualityMeasurement ;
    rdfs:label "Female Group Representation" ;
    dqv:inDimension abox:Fairness .

abox:GroupRepresentation_Male a dqv:Metric,
        dqv:QualityMeasurement ;
    rdfs:label "Male Group Representation" ;
    dqv:inDimension abox:Fairness .

abox:MaleGroup tbox:groupValue "M" ;
    tbox:targetPercentage 50.0 .

abox:Patient_Summary_Acces a tbox:Acces ;
    rdfs:label abox:Static ;
    tbox:path "/home/acraf/psr/Fdatavalidation-1/DataProductLayer/DataProduct_EHDS_AMR/Data/Patient_Summary.csv" .

abox:StatisticalValidity a dqv:Dimension .

abox:Timeliness a dqv:Dimension ;
    rdfs:label "Timeliness (ISO/IEC 25012)" .

abox:TotalIsolateCount a dqv:Metric,
        dqv:QualityMeasurement ;
    rdfs:label "Total Isolate Count Metric" ;
    rdfs:comment "Sum of nIsolates across all specimens in the AMR dataset" ;
    dqv:inDimension abox:StatisticalValidity .

