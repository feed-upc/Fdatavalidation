abox:DQRP1 a dqv:QualityPolicy ;
    rdfs:label "DQRP1 - Timeliness Requirement" ;
    tbox:derivedFrom "DQRP1" ;
    tbox:qualityDimension "Timeliness" ;
    tbox:sourceEntity abox:DataSpaceGovernanceAuthority ;
    rdfs:comment "Data Quality Requirement Pattern 1: A specific data age is required for the data in an attribute of an entity. The lastUpdated timestamp must not exceed 30 minutes from the current time (ISO/IEC 25012 Timeliness)" ;
    odrl:permission abox:DQRP1_Permission .

abox:DQRP2 a dqv:QualityPolicy ;
    rdfs:label "DQRP2 - Completeness Requirement" ;
    tbox:derivedFrom "DQRP2" ;
    tbox:qualityDimension "Completeness" ;
    tbox:sourceEntity abox:DataSpaceGovernanceAuthority ;
    rdfs:comment "Data Quality Requirement Pattern 2: Completeness check. The Subject (Patient ID) must be 100% complete (no nulls)." ;
    odrl:permission abox:DQRP2_Permission .

