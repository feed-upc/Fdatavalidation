            tbox:type "string" ],
        [ tbox:description "Data to assess" ;
            tbox:name "data" ;
            tbox:role "previousResult" ;
            tbox:type "DataFrame" ] ;
    ns1:comment "DQRP6 (DQR5EH): Fairness check - calculates max percentage of any discrete group" .

