@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix : <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/shapes#> .

# ============================================================================
# SHACL Shapes for PolicyChecker Validation
# ============================================================================
# Ensures PolicyCheckers generated by planner_n3.py are structurally consistent
# and have proper input/output flow through operation chains.
# ============================================================================

# ----------------------------------------------------------------------------
# Shape 1: PolicyChecker Structure
# ----------------------------------------------------------------------------
# Validates that PolicyChecker has all required properties

:PolicyCheckerShape a sh:NodeShape ;
    sh:targetClass tb:PolicyChecker ;
    sh:message "PolicyChecker must have required properties and valid structure" ;
    
    # Must have exactly one accordingTo (policy reference)
    sh:property [
        sh:path tb:accordingTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "PolicyChecker must reference exactly one policy via tb:accordingTo" ;
    ] ;
    
    # Must have exactly one validates (data product reference)
    sh:property [
        sh:path tb:validates ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "PolicyChecker must validate exactly one data product via tb:validates" ;
    ] ;
    
    # Must have exactly one nextStep (first operation)
    sh:property [
        sh:path tb:nextStep ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class tb:Operation ;
        sh:message "PolicyChecker must have exactly one tb:nextStep pointing to an Operation" ;
    ] ;
    
    # Must NOT have hasInput or hasOutput (operations have those, not PolicyCheckers)
    sh:property [
        sh:path tb:hasInput ;
        sh:maxCount 0 ;
        sh:message "PolicyChecker should not have tb:hasInput (only Operations have input)" ;
    ] ;
    
    sh:property [
        sh:path tb:hasOutput ;
        sh:maxCount 0 ;
        sh:message "PolicyChecker should not have tb:hasOutput (only Operations have output)" ;
    ] .

# ----------------------------------------------------------------------------
# Shape 2: Operation Structure
# ----------------------------------------------------------------------------
# Validates that Operations have proper input/output and abstract

:OperationShape a sh:NodeShape ;
    sh:targetClass tb:Operation ;
    sh:message "Operation must have required properties" ;
    
    # Must have exactly one hasAbstract (operation type)
    sh:property [
        sh:path tb:hasAbstract ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Operation must have exactly one tb:hasAbstract defining its type" ;
    ] ;
    
    # Must have exactly one hasInput
    sh:property [
        sh:path tb:hasInput ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Operation must have exactly one tb:hasInput" ;
    ] ;
    
    # Must have exactly one hasOutput
    sh:property [
        sh:path tb:hasOutput ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Operation must have exactly one tb:hasOutput" ;
    ] ;
    
    # May have zero or one nextStep (terminal operations don't have nextStep)
    sh:property [
        sh:path tb:nextStep ;
        sh:maxCount 1 ;
        sh:message "Operation can have at most one tb:nextStep" ;
    ] .

# ----------------------------------------------------------------------------
# Shape 3: LoadData Operation
# ----------------------------------------------------------------------------
# Validates LoadData operations have correct structure

:LoadDataShape a sh:NodeShape ;
    sh:targetSubjectsOf tb:hasAbstract ;
    sh:message "LoadData operation must have correct structure" ;
    
    sh:sparql [
        sh:message "LoadData operation must output ab:data" ;
        sh:select """
            PREFIX tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#>
            PREFIX ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#>
            SELECT $this
            WHERE {
                $this tb:hasAbstract ab:LoadData .
                $this tb:hasOutput ?output .
                FILTER(?output != ab:data)
            }
        """ ;
    ] ;
    
    sh:sparql [
        sh:message "LoadData operation must have file path as input" ;
        sh:select """
            PREFIX tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#>
            PREFIX ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#>
            SELECT $this
            WHERE {
                $this tb:hasAbstract ab:LoadData .
                $this tb:hasInput ?input .
                FILTER(!isLiteral(?input))
            }
        """ ;
    ] .

# ----------------------------------------------------------------------------
# Shape 4: Report Node Structure
# ----------------------------------------------------------------------------
# Validates Report nodes are terminal and have input

:ReportShape a sh:NodeShape ;
    sh:targetClass tb:Report ;
    sh:message "Report must be terminal node with input" ;
    
    # Must have exactly one hasInput
    sh:property [
        sh:path tb:hasInput ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Report must have exactly one tb:hasInput" ;
    ] ;
    
    # Must have valid input (either ab:data or ab:boolean)
    sh:property [
        sh:path tb:hasInput ;
        sh:in ( ab:data ab:boolean ) ;
        sh:message "Report input must be either ab:data or ab:boolean" ;
    ] ;
    
    # Must NOT have nextStep (terminal node)
    sh:property [
        sh:path tb:nextStep ;
        sh:maxCount 0 ;
        sh:message "Report must be terminal - cannot have tb:nextStep" ;
    ] ;
    
    # Must NOT have hasOutput (terminal node)
    sh:property [
        sh:path tb:hasOutput ;
        sh:maxCount 0 ;
        sh:message "Report must not have tb:hasOutput" ;
    ] ;
    
    # Must NOT have hasAbstract (only Operations have abstract)
    sh:property [
        sh:path tb:hasAbstract ;
        sh:maxCount 0 ;
        sh:message "Report must not have tb:hasAbstract (only Operations have abstract)" ;
    ] .

# ----------------------------------------------------------------------------
# Shape 5: Validation Operation Output
# ----------------------------------------------------------------------------
# Validates that validation operations output boolean

:ValidationOperationShape a sh:NodeShape ;
    sh:targetSubjectsOf tb:hasAbstract ;
    sh:message "Validation operations must output ab:boolean" ;
    
    sh:sparql [
        sh:message "Quality/Schema/Fairness/Correctness operations must output ab:boolean" ;
        sh:select """
            PREFIX tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#>
            PREFIX ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#>
            SELECT $this
            WHERE {
                $this tb:hasAbstract ?abstract .
                $this tb:hasOutput ?output .
                FILTER(
                    (?abstract = ab:TypeCheck || ?abstract = ab:qM || 
                     ?abstract = ab:FairnessTest || ?abstract = ab:ConstraintCheck) &&
                    ?output != ab:boolean
                )
            }
        """ ;
    ] .

# ----------------------------------------------------------------------------
# Shape 6: Chain Connectivity
# ----------------------------------------------------------------------------
# Validates that operation chains are properly connected

:ChainConnectivityShape a sh:NodeShape ;
    sh:targetClass tb:PolicyChecker ;
    sh:message "PolicyChecker operation chain must be properly connected" ;
    
    # Check that all operations in chain are reachable
    sh:sparql [
        sh:message "All operations must be part of a chain starting from PolicyChecker" ;
        sh:select """
            PREFIX tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this ?orphan
            WHERE {
                # Find operations that might be orphaned
                ?orphan rdf:type tb:Operation .
                
                # Check if this operation is NOT reachable from any PolicyChecker
                FILTER NOT EXISTS {
                    $this tb:nextStep+ ?orphan .
                }
                
                # Also check it's not the first step
                FILTER NOT EXISTS {
                    $this tb:nextStep ?orphan .
                }
            }
        """ ;
    ] .

# ----------------------------------------------------------------------------
# Shape 7: No Cycles in Chain
# ----------------------------------------------------------------------------
# Validates that operation chains don't have cycles

:NoCyclesShape a sh:NodeShape ;
    sh:targetClass tb:PolicyChecker ;
    sh:message "Operation chains must not contain cycles" ;
    
    sh:sparql [
        sh:message "Operation chain contains a cycle" ;
        sh:select """
            PREFIX tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#>
            SELECT $this ?op
            WHERE {
                $this tb:nextStep+ ?op .
                ?op tb:nextStep+ ?op .
            }
        """ ;
    ] .

# ----------------------------------------------------------------------------
# Shape 8: Terminal Operations have Report
# ----------------------------------------------------------------------------
# Validates that all terminal operations link to a Report

:TerminalOperationShape a sh:NodeShape ;
    sh:targetClass tb:Operation ;
    sh:message "Terminal operations must link to Report node" ;
    
    sh:sparql [
        sh:message "Operation without nextStep must link to a Report" ;
        sh:select """
            PREFIX tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                $this rdf:type tb:Operation .
                FILTER NOT EXISTS { $this tb:nextStep ?next }
            }
        """ ;
    ] ;
    
    # If operation has nextStep, either it's another Operation or a Report
    sh:property [
        sh:path tb:nextStep ;
        sh:or (
            [ sh:class tb:Operation ]
            [ sh:class tb:Report ]
        ) ;
        sh:message "Operation nextStep must point to either another Operation or a Report" ;
    ] .
