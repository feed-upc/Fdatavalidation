# N3 Logic Rule: Quality Measurement Policy Transformation
# Rule Chaining - Automatically chains from LoadData operation
#
# Transforms DQV Quality policies into data quality validation operations.

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Rule 1: Quality Policy with Constraint → Validation Operation
# Chains from LoadData when Quality policy with constraint exists
{
    # Match PolicyChecker with Quality policy
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:nextStep ?loadOp .
    
    # LoadData operation
    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .
    
    # Quality policy structure
    ?policy a dqv:QualityPolicy ;
            odrl:duty ?duty .
    
    ?duty odrl:target ?target ;
          odrl:constraint ?constraint .
    
    # Constraint details
    ?constraint odrl:leftOperand ?metric ;
                odrl:rightOperand ?threshold ;
                odrl:operator ?operator .
}
=>
{
    # Create quality validation operation chained from LoadData
    _:qualityOp a tb:Operation ;
                tb:hasInput ?target ;       # Attribute to measure
                tb:hasAbstract ?metric ;     # Quality metric (e.g., dqv:completeness)
                tb:hasConstraint ?constraint ;
                tb:hasOutput ab:boolean .    # Validation result
    
    # Chain from LoadData
    ?loadOp tb:nextStep _:qualityOp .
} .
