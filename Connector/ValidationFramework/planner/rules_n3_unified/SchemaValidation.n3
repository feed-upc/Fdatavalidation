# N3 Logic Rule: Schema Validation Policy Transformation
# Rule Chaining - Automatically chains from LoadData operation
#
# Transforms schema/type validation policies into type checking operations.

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Rule 1: Type Constraint → Schema Validation Operation
# Chains from LoadData when policy has type checking constraint (odrl:isA)
{
    # Match PolicyChecker with policy containing type constraint
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:nextStep ?loadOp .
    
    # LoadData operation
    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .
    
    # Policy with duty containing type constraint
    ?policy odrl:duty ?duty .
    
    ?duty odrl:target ?target ;
          odrl:constraint ?constraint .
    
    # Constraint with isA operator (type checking)
    ?constraint odrl:leftOperand ?target ;
                odrl:operator "odrl:isA" ;
                odrl:rightOperand ?expectedType .
}
=>
{
    # Create schema validation operation chained from LoadData
    _:schemaOp a tb:Operation ;
               tb:hasInput ?target ;          # Attribute to validate
               tb:hasAbstract ab:TypeCheck ;   # Schema validation
               tb:hasConstraint ?constraint ;
               tb:hasOutput ab:boolean .       # Validation result
    
    # Chain from LoadData
    ?loadOp tb:nextStep _:schemaOp .
} .
