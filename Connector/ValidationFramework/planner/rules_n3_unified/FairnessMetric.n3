# N3 Logic Rule: Fairness Metric Policy Transformation
# Rule Chaining - Automatically chains from LoadData operation
#
# Transforms Fairness policies into ML model fairness validation operations.

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Rule 1: Fairness Policy → Fairness Test Operation
# Chains from LoadData when Fairness policy exists
{
    # Match PolicyChecker with Fairness policy
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:nextStep ?loadOp .
    
    # LoadData operation
    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .
    
    # Fairness policy structure
    ?policy a tb:FairnessPolicy ;
            odrl:duty ?duty .
    
    ?duty odrl:target ?target ;
          odrl:constraint ?constraint .
    
    # Constraint references fairness test
    ?constraint odrl:leftOperand ?fairnessTest ;
                odrl:operator ?operator ;
                odrl:rightOperand ?threshold .
}
=>
{
    # Create fairness validation operation chained from LoadData
    _:fairnessOp a tb:Operation ;
                 tb:hasInput ?target ;          # Protected attribute
                 tb:hasAbstract ?fairnessTest ;  # Fairness metric
                 tb:hasConstraint ?constraint ;
                 tb:hasOutput ab:boolean .       # Validation result
    
    # Chain from LoadData
    ?loadOp tb:nextStep _:fairnessOp .
} .
