# N3 Logic Rule: Data Correctness Policy Transformation
# Rule Chaining - Automatically chains from LoadData operation
#
# Transforms Data Correctness prohibition policies into constraint checking operations.

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Rule 1: Data Correctness Prohibition → Constraint Validation Operation
# Chains from LoadData when DCPolicy with prohibition exists
{
    # Match PolicyChecker with Data Correctness policy
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:nextStep ?loadOp .
    
    # LoadData operation
    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .
    
    # Data Correctness policy with prohibition
    ?policy a tb:DCPolicy ;
            odrl:prohibition ?prohibition .
    
    ?prohibition odrl:target ?target ;
                 odrl:constraint ?constraint .
    
    # Constraint details
    ?constraint odrl:leftOperand ?leftOp ;
                odrl:operator ?operator ;
                odrl:rightOperand ?rightOp .
}
=>
{
    # Create constraint validation operation chained from LoadData
    # Prohibition means: ensure constraint is NOT violated
    _:correctnessOp a tb:Operation ;
                    tb:hasInput ?target ;          # Attribute to check
                    tb:hasAbstract ab:ConstraintCheck ;
                    tb:hasConstraint ?constraint ;
                    tb:hasOutput ab:boolean .      # Validation result
    
    # Chain from LoadData
    ?loadOp tb:nextStep _:correctnessOp .
} .
