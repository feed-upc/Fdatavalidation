# N3 Logic Rule: Timeliness/Freshness Policy Transformation (SEMANTIC VERSION)
# Rule Chaining - Automatically chains from LoadData operation
#
# Transforms ODRL Permission policies with freshness constraints into data age validation operations.
# USES SEMANTIC PROPERTIES instead of flat hasInput for unambiguous parameter binding.

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Rule: Quality Policy with Permission and Freshness Constraint → CheckFreshness + Validation Operations
# Chains from LoadData when Quality policy with permission and timeliness constraint exists
# Creates TWO operations with SEMANTIC properties
{
    # Match PolicyChecker with Quality policy
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:nextStep ?loadOp .
    
    # LoadData operation
    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .
    
    # Quality policy with permission structure
    ?policy a dqv:QualityPolicy ;
            odrl:permission ?permission .
    
    ?permission odrl:constraint ?constraint ;
                odrl:target ?commonDataModel .
    
    # Constraint targeting DataAge measurement
    ?constraint odrl:leftOperand ?dataAgeMeasurement ;
                odrl:operator ?operator ;
                odrl:rightOperand ?maxAge .
    
    # DataAge measurement references timestamp feature
    ?dataAgeMeasurement a dqv:QualityMeasurement ;
                        dqv:computedOn ?timestampFeature ;
                        dqv:isMeasurementOf ?freshnessMetric .
    
    ?freshnessMetric dqv:inDimension ?timelinessDimension .
    
    # Get physical attribute for timestamp from ConstraintPropagation rule
    ?permission tb:physicalAttribute ?physicalTimestamp .
}
=>
{
    # Operation 1: CheckFreshness - compute age from timestamp
    # ROLE-ANNOTATED INPUTS: Each input has explicit role
    _:freshnessOp a tb:Operation ;
                  tb:hasAbstract ab:CheckFreshness ;
                  tb:hasInput [
                      tb:value ?physicalTimestamp ;
                      tb:role "timestampAttribute"
                  ] ;
                  tb:hasInput [
                      tb:value ab:data ;
                      tb:role "previousResult"
                  ] ;
                  tb:hasOutput ab:data ;
                  tb:nextStep _:validationOp .
    
    # Chain Operation 1 from LoadData
    ?loadOp tb:nextStep _:freshnessOp .
    
    # Operation 2: Constraint validation - check age against threshold (TERMINAL)
    # ROLE-ANNOTATED INPUTS: Multiple inputs with different roles
    _:validationOp a tb:Operation ;
                   tb:hasAbstract odrl:Constraint ;
                   tb:hasInput [
                       tb:value ab:data ;
                       tb:role "previousResult"
                   ] ;
                   tb:hasInput [
                       tb:value ?maxAge ;
                       tb:role "threshold"
                   ] ;
                   tb:hasInput [
                       tb:value ?operator ;
                       tb:role "operator"
                   ] ;
                   tb:hasOutput ab:data ;
                   tb:isTerminal true .
    
    # Chain Operation 2 from Operation 1
    _:freshnessOp tb:nextStep _:validationOp .
} .
